# Copy this file to .env and fill in your credentials.
# Never commit the real .env file to Git.

APP_NAME=Secure Examination Management System
ENVIRONMENT=development

# --- Neon (or any PostgreSQL provider) ---
# Pooled connection string — used by the application (SQLAlchemy engine).
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Direct (non-pooled) connection string — used by Alembic migrations.
# For plain PostgreSQL (no PgBouncer) this can be the same as DATABASE_URL.
DIRECT_URL=postgresql+psycopg2://user:password@direct-host/dbname?sslmode=require

# --- Legacy local-dev fallback (used when DATABASE_URL is absent) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secure_exam_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT settings (generate a strong random secret for production)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional Google Gemini API key for AI evaluation of short answers
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL for public verification links (used in QR codes)
PUBLIC_BASE_URL=http://127.0.0.1:8000
